#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> pnpm"
want="$(node -p "require('./package.json').packageManager")"
if [ "$(pnpm -v 2>/dev/null || true)" != "${want#pnpm@}" ]; then
  # Node 26 no longer ships corepack; install the pinned pnpm directly.
  npm install -g --force "$want"
fi

echo "==> pnpm install"
time pnpm install --frozen-lockfile
