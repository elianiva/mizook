#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

echo "==> pnpm"
want="$(node -p "require('./package.json').packageManager")"
if [ "$(pnpm -v 2>/dev/null || true)" != "${want#pnpm@}" ]; then
  command -v corepack >/dev/null 2>&1 || npm install -g --force corepack
  corepack enable
  corepack prepare "$want" --activate
fi

echo "==> pnpm install"
time pnpm install --frozen-lockfile
