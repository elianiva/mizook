{
  "name": "mizook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "alchemy dev",
    "deploy": "alchemy deploy",
    "destroy": "alchemy destroy",
    "webhook": "node --env-file=.env scripts/set-webhook.ts",
    "test": "vp test",
    "check": "vp check",
    "fmt": "vp check --fix",
    "lint": "vp lint",
    "prepare": "lefthook install && effect-tsrs patch --oxlint",
    "typecheck": "tsrs --noEmit -p tsconfig.json && tsrs --noEmit -p packages/memory/tsconfig.json && effect-tsrs diagnostics --strict --project tsconfig.json && effect-tsrs diagnostics --strict --project packages/memory/tsconfig.json"
  },
  "dependencies": {
    "@chat-adapter/state-memory": "^4.41.1",
    "@chat-adapter/telegram": "^4.41.1",
    "@earendil-works/chord": "^1.2.0",
    "@earendil-works/pi-ai": "^1.2.0",
    "@earendil-works/pi-durable": "^1.2.0",
    "@effect/platform-node": "^4.0.4",
    "@mizook/memory": "workspace:*",
    "alchemy": "2.0.0-beta.83",
    "chat": "^4.41.1",
    "croner": "^11.0.1",
    "effect": "^4.0.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@effect/language-service": "0.87.5",
    "@types/node": "^26.6.5",
    "@yielded/effect-tsrs": "0.2.3",
    "lefthook": "2.2.2",
    "tsrs": "0.22.0-ts7.1.0-beta",
    "vite-plus": "1.4.0"
  },
  "packageManager": "pnpm@11.15.1"
}
