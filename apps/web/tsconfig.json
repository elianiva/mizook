{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "moduleResolution": "Bundler",
    "types": ["vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": { "allowedUnstableApis": ["effect/socket"] }
          }
        ]
      }
    ]
  },
  "include": ["src", "panda.config.ts", "vite.config.ts"],
  "exclude": ["src/sw.ts"]
}
